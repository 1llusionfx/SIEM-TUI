{
  "name": "loganalyzer-tui",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --tsconfig tsconfig.check.json --test tests/dashboard.test.tsx",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "better-sqlite3": "^11.10.0",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^20",
    "@types/react": "^18",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4",
    "typescript": "~5.8.3"
  }
}
